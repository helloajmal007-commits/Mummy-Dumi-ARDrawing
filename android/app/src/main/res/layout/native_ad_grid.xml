<?xml version="1.0" encoding="utf-8"?>
<!--
  Grid-cell native ad — styled to sit as one tile among category/image
  grid cells (roughly square, icon + headline + small CTA, no body
  text since a grid cell has no room for three lines). Distinct from
  native_ad_small.xml (horizontal list-row layout used in Home/Learn).

  Policy note: the "Ad" attribution badge is REQUIRED and must stay
  visible and legible — do not remove it or shrink it further.
-->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/native_ad_grid_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <!-- Ad attribution row: required, must stay visible. Placed
             top-left like the category cards' icon badge slot. -->
        <TextView
            android:id="@+id/ad_attribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:background="#FFC107"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="Ad"
            android:textAllCaps="true"
            android:textColor="#000000"
            android:textSize="9sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/native_ad_icon_bg">

            <ImageView
                android:id="@+id/ad_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#1A1A1A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Body intentionally omitted — no room in a square grid cell. -->

        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="@drawable/native_ad_cta_bg"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>